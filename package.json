{
  "name": "hue-hop",
  "version": "0.1.0",
  "description": "Give each letter of a heading or name its own color, stepped from one color to another.",
  "keywords": [
    "web-components",
    "custom-element",
    "css",
    "oklch",
    "color",
    "typography",
    "heading",
    "highlight-api"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Brian Talbot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talbs/hue-hop.git"
  },
  "homepage": "https://talbs.github.io/hue-hop/",
  "bugs": "https://github.com/talbs/hue-hop/issues",
  "exports": {
    ".": {
      "types": "./hue-hop.d.ts",
      "default": "./dist/hue-hop.js"
    },
    "./drift.css": "./dist/drift.css",
    "./hues.css": "./dist/hues.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/hue-hop.js",
    "./dist/*.css"
  ],
  "customElements": "custom-elements.json",
  "jsdelivr": "./dist/hue-hop.js",
  "unpkg": "./dist/hue-hop.js",
  "files": [
    "dist",
    "hue-hop.d.ts",
    "custom-elements.json",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "size": "node scripts/size.js",
    "pretest": "npm run build",
    "test": "prettier --check . --ignore-path .gitignore --ignore-path \"$(git rev-parse --git-path info/exclude)\" && node --test 'test/*.test.js'",
    "prepack": "npm run build && npm run size && node scripts/changelog.js",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path \"$(git rev-parse --git-path info/exclude)\"",
    "prepublishOnly": "npm test",
    "site": "npm run build && node scripts/site.js",
    "serve": "npm run build && node scripts/site.js --serve"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "esbuild": "0.28.2",
    "microlighter": "^2.2.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  }
}
