{
  "name": "hue-hop",
  "version": "0.4.0",
  "description": "Give each letter of a heading or name its own color, stepped from one color to another.",
  "keywords": [
    "web-components",
    "custom-element",
    "css",
    "oklch",
    "color",
    "typography",
    "heading",
    "highlight-api"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Brian Talbot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talbs/hue-hop.git"
  },
  "homepage": "https://huehop.dev/",
  "bugs": "https://github.com/talbs/hue-hop/issues",
  "exports": {
    ".": {
      "types": "./hue-hop.d.ts",
      "default": "./dist/hue-hop.js"
    },
    "./element": {
      "types": "./element.d.ts",
      "default": "./dist/element.js"
    },
    "./drift.css": "./dist/drift.css",
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/hue-hop.js",
  "types": "./hue-hop.d.ts",
  "sideEffects": [
    "./dist/hue-hop.js",
    "./dist/*.css"
  ],
  "customElements": "custom-elements.json",
  "jsdelivr": "./dist/hue-hop.js",
  "unpkg": "./dist/hue-hop.js",
  "files": [
    "dist",
    "hue-hop.d.ts",
    "element.d.ts",
    "custom-elements.json",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "size": "node scripts/size.js",
    "pretest": "npm run build",
    "test": "prettier --check . --ignore-path .gitignore --ignore-path \"$(git rev-parse --git-path info/exclude)\" && node --test --test-timeout=60000 'test/*.test.js'",
    "prepack": "npm run build && npm run size && node scripts/changelog.js",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path \"$(git rev-parse --git-path info/exclude)\"",
    "prepublishOnly": "npm test",
    "site": "npm run build && node scripts/site.js",
    "serve": "npm run build && node scripts/site.js --serve"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "esbuild": "0.28.2",
    "microlighter": "^2.2.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
